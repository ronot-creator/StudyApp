{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for Convergence main shell, MCP sidecar, and locked-down persist:ai_* WebViews scoped to $APPLOCALDATA/**",
  "windows": [
    "main",
    "ai_panel_*",
    "ai_float_*",
    "ai_panel_gemini",
    "ai_panel_chatgpt",
    "ai_panel_claude",
    "ai_panel_notebooklm",
    "ai_float_gemini",
    "ai_float_chatgpt",
    "ai_float_claude",
    "ai_float_notebooklm"
  ],
  "webviews": [
    "main",
    "ai_panel_*",
    "ai_float_*"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "path:default",
    "core:window:default",
    "core:window:create",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:webview:default",
    "core:webview:create",
    "core:webview:allow-create-webview",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-webview-close",
    "core:webview:allow-webview-show",
    "core:webview:allow-webview-hide",
    "switch_active_ai_panel",
    "detach_ai_panel",
    "redock_ai_panel",
    "resize_docked_ai_panel",
    "navigate_ai_panel",
    "mount_persistent_ai_panel",
    "update_active_highlight",
    "get_mcp_sidecar_status",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "fs:default",
    "fs:allow-app-local-data-recursive",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPLOCALDATA"
        },
        {
          "path": "$APPLOCALDATA/**"
        }
      ]
    },
    "allow-resolve-shorthand-query",
    "allow-copy-ingested-raw-asset",
    "allow-spawn-custom-ai-panel",
    "allow-get-storage-config",
    "allow-set-custom-storage-dir",
    "allow-append-webview-footnote",
    "allow-purge-ai-partition"
  ],
  "profiles": {
    "persist:ai_*": {
      "identifier": "persist-ai-webview-lockdown",
      "description": "Strict IPC lockdown profile for persist:ai_* dynamic AI WebView partitions: ONLY allows resolve_shorthand_query and denies all fs, shell, and dialog plugin accesses.",
      "windows": [
        "ai_panel_*",
        "ai_float_*",
        "persist:ai_*"
      ],
      "webviews": [
        "ai_panel_*",
        "ai_float_*",
        "persist:ai_*"
      ],
      "allow": [
        "resolve_shorthand_query",
        "allow-resolve-shorthand-query"
      ],
      "deny": [
        "fs:default",
        "fs:allow-read-file",
        "fs:allow-write-file",
        "fs:allow-read-text-file",
        "fs:allow-write-text-file",
        "fs:allow-app-local-data-recursive",
        "fs:allow-mkdir",
        "fs:allow-exists",
        "shell:default",
        "shell:allow-open",
        "shell:allow-execute",
        "shell:allow-spawn",
        "dialog:default",
        "dialog:allow-open",
        "dialog:allow-save"
      ]
    }
  }
}
