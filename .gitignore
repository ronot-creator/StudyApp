MyFiles/srs_data/*.db
MyFiles/srs_data/*.sqlite
MyFiles/srs_data/*.sqlite3
MyFiles/srs_data/*.db-wal
MyFiles/srs_data/*.db-shm
!MyFiles/srs_data/schema.sql
!MyFiles/srs_data/.gitkeep

# Persistent WebView session partition data
MyFiles/.webview_partitions/
.webview_partitions/

